# Flask Application Configuration
# Copy this file to .env and update values as needed

# Security
SECRET_KEY=your-secret-key-change-in-production

# Admin Default Password (used by flask seed-admin command)
ADMIN_DEFAULT_PASSWORD=admin123

# Database
SQLALCHEMY_DATABASE_URI=sqlite:////workspace/innovation-hub-lab/instance/app.db

# Excel Configuration
EXCEL_FILE_PATH=/workspace/innovation-hub-lab/data/responses.xlsx
EXCEL_SHEET_NAME=Sheet1
EXCEL_HEADER_ROW=1

# Storage Paths
STORAGE_PATH=/workspace/innovation-hub-lab/storage
PHOTO_STORAGE_PATH=/workspace/innovation-hub-lab/storage/photos

# ESP32 Configuration
ESP_TIMEOUT_SECONDS=10
ESP_RETRY_COUNT=3

# Photo Retention (days)
PHOTO_RETENTION_DAYS=30
PHOTO_DELETION_HOUR=2

# Logging
LOG_LEVEL=INFO
